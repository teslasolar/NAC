    { "id": "CLAIM_OVERDUE", "priority": "MEDIUM", "message": "Claim processing overdue" },
    { "id": "AUDIT_FINDING", "priority": "HIGH", "message": "New audit finding" },
    { "id": "PAYROLL_ERROR", "priority": "CRITICAL", "message": "Payroll calculation error" },
    { "id": "COMPLIANCE_VIOLATION", "priority": "CRITICAL", "message": "Compliance violation detected" }

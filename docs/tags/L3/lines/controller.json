        {
          "id": "audit-followup",
          "name": "Follow-up",
          "description": "Track finding resolution",
          "capacity": 1,
          "cycleTimeMinutes": 120,
          "requiredSkills": ["tracking"],
          "equipment": ["finding-tracker"]
        }

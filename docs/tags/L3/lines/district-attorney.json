          "cycleTimeMinutes": 120,
          "inputTypes": ["case_assigned"],
          "outputType": "charges_filed",
          "requiredSkills": ["legal-analysis"],
          "equipment": ["case-management-system"]
        },
        {
          "id": "discovery",
          "name": "Discovery",
          "description": "Prepare and provide discovery to defense",
          "capacity": 15,
          "cycleTimeMinutes": 180,
          "inputTypes": ["charges_filed"],
          "outputType": "discovery_complete",
          "requiredSkills": ["discovery-preparation"],
          "equipment": ["document-system", "redaction-tools"]
        },
        {
          "id": "plea-negotiation",
          "name": "Plea Negotiation",

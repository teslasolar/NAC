          "inputTypes": ["plea_entered"],
          "outputType": "verdict_entered",
          "requiredSkills": ["trial-advocacy"],
          "equipment": ["courtroom", "presentation-system"]
        },
        {
          "id": "sentencing",
          "name": "Sentencing",
          "description": "Present sentencing recommendation",
          "capacity": 10,
          "cycleTimeMinutes": 60,
          "inputTypes": ["verdict_entered"],
          "outputType": "completed",
          "requiredSkills": ["sentencing-advocacy"],
          "equipment": ["case-management-system"]
        }
      ]
    },
    {
      "id": "diversion-program",

  "interlocks": [
    {
      "name": "QuorumInterlock",
      "condition": "PresentMembers < 5",
      "action": "BLOCK all votes, adjourn or recess until quorum"
    },
    {
      "name": "SunshineActInterlock",
      "condition": "Meeting not properly advertised",
      "action": "INVALID - actions taken are void"
    },
    {
      "name": "TwoReadingInterlock",
      "condition": "DaysBetweenReadings < 7 AND NOT EmergencyOrdinance",
      "action": "BLOCK second reading vote"
    }
  ]

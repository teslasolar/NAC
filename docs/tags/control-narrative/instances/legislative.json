        "ordinances": "5+ YES votes with quorum present",
        "resolutions": "5+ YES votes with quorum present",
        "vetoOverride": "6+ YES votes",
        "charterAmendment": "6+ YES votes + voter referendum"
      }
    },
    "ordinanceWorkflow": {
      "stateMachine": "See UDT_Ordinance.stateTransitions",

{
  "tagType": "Workflow",
  "id": "document_recording",
  "description": "Document recording workflow",
  "slaBusinessDays": 1,
  "states": ["submitted", "reviewed", "recorded", "indexed", "available"],
  "transitions": [
    {
      "from": "submitted",
      "to": "reviewed",
      "action": "review_document",
      "conditions": ["fee_paid"],
      "slaHours": 2
    },
    {
      "from": "reviewed",
      "to": "recorded",
      "action": "record_document",
      "conditions": ["requirements_met"],
      "slaHours": 1
    },
    {
      "from": "recorded",
      "to": "indexed",
      "action": "index_document",
      "slaHours": 4
    },
    {
      "from": "indexed",
      "to": "available",
      "action": "make_public",
      "slaHours": 1
    }
  ],
  "rejectionReasons": [
    "illegible",
    "missing_signatures",
    "missing_notarization",
    "incorrect_fee",
    "missing_transfer_tax"
  ]
}
